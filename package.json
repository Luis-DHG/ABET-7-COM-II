{
  "name": "blogdpc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @blogdpc/contracts build && pnpm --filter @blogdpc/server build && pnpm --filter @blogdpc/web build",
    "check": "pnpm --filter @blogdpc/contracts check && pnpm --filter @blogdpc/contracts build && pnpm --filter @blogdpc/server check && pnpm --filter @blogdpc/web check",
    "dev": "pnpm --filter @blogdpc/contracts build && pnpm --filter @blogdpc/server dev",
    "start": "pnpm --filter @blogdpc/server start",
    "test": "pnpm --filter @blogdpc/server test && pnpm --filter @blogdpc/web test",
    "lint": "pnpm --filter @blogdpc/web lint",
    "db:audit": "pnpm --filter @blogdpc/server db:audit",
    "db:cleanup": "pnpm --filter @blogdpc/server db:cleanup",
    "db:generate": "pnpm --filter @blogdpc/server db:generate",
    "db:migrate": "pnpm --filter @blogdpc/server db:migrate",
    "db:provision-role": "pnpm --filter @blogdpc/server db:provision-role",
    "db:verify": "pnpm --filter @blogdpc/server db:verify",
    "admin:create": "pnpm --filter @blogdpc/server admin:create"
  }
}
