# BlogDPC · ISAC — variables de entorno (ejemplo para despliegue local con Docker).
# Copia a `.env` en la raíz y ajusta. Si no existe `.env`, docker-compose usa
# los valores por defecto definidos en `docker-compose.yml`.
#
#   Copy-Item .env.example .env   # (PowerShell)

# Origen público de la app (sin trailing slash). En local con compose: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Postgres local del compose (servicio `postgres`). Requiere esquema postgres:// o postgresql://
DATABASE_URL=postgresql://blogdpc:blogdpc@postgres:5432/blogdpc
# En local (sin TLS) debe ser false; en Supabase/producción, true
DATABASE_SSL=false

# Secreto JWT (mínimo 32 caracteres). ¡Cambiar fuera de local!
JWT_ACCESS_SECRET=dev-local-secret-cambiar-minimo-32-chars-123456
# En local (HTTP) debe ser false; en producción (HTTPS), true
COOKIE_SECURE=false

# SMTP de prueba: Mailpit del compose (UI en http://localhost:8025).
# Mailpit acepta cualquier credencial; estos valores solo deben pasar la validación.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=dev@local.test
SMTP_APP_PASSWORD=devpassword
MAIL_FROM=BlogDPC ISAC <dev@local.test>

# Google OAuth: valores dummy para local (el login con Google no funcionará
# sin credenciales reales, pero el resto de la página sí).
GOOGLE_CLIENT_ID=local-dev
GOOGLE_CLIENT_SECRET=local-dev
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
