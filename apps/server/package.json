{
  "name": "@blogdpc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "admin:create": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:audit": "tsx --env-file-if-exists=../../.env src/db/audit.ts",
    "db:cleanup": "tsx --env-file-if-exists=../../.env src/db/cleanup-tokens.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:provision-role": "tsx --env-file-if-exists=../../.env src/db/provision-role.ts",
    "db:verify": "tsx --env-file-if-exists=../../.env src/db/verify.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "prestart": "node --env-file-if-exists=../../.env dist/db/migrate.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@blogdpc/contracts": "workspace:*",
    "cookie": "2.0.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "openid-client": "6.8.8",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
