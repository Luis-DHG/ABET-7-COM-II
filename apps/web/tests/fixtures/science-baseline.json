      "bandwidthSpacing": "\\Delta f = \\frac{B}{N}",
      "symbolDuration": "T_{\\mathrm{sym}} = \\frac{1{,}25}{\\Delta f}",
      "qpskRate": "R_{\\mathrm{QPSK}} = \\frac{2N}{T_{\\mathrm{sym}}}\\;\\mathrm{bit/s}",
      "wavelength": "\\lambda = \\frac{c}{f_c}\\;[\\mathrm{m}]",
      "doppler": "f_D = \\frac{2vf_c}{c}\\;[\\mathrm{Hz}]",
      "ber": "\\mathrm{BER} = \\frac{\\text{bits erróneos}}{\\text{bits transmitidos}}",
      "snr": "\\mathrm{SNR}_{\\mathrm{dB}} = 10\\log_{10}\\!\\left(\\frac{P_{\\text{señal}}}{P_{\\text{ruido}}}\\right)\\;[\\mathrm{dB}]",
