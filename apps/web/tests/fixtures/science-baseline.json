      "crlb": "\\operatorname{Var}(\\hat{R}) \\ge \\operatorname{CRLB}_{R}\\;[\\mathrm{m}^2]",
      "powerSplit": "P_c = \\alpha P_{\\mathrm{total}}, \\qquad P_s = (1-\\alpha)\\,P_{\\mathrm{total}}, \\qquad 0 \\le \\alpha \\le 1",
      "shannonCapacity": "R = B\\,\\log_2\\!\\left(1 + \\mathrm{SNR}_{\\mathrm{com}}\\right) \\;[\\mathrm{bit/s}]",
      "commSnr": "\\mathrm{SNR}_{\\mathrm{com}} = \\frac{|h|^2\\,P_c}{k\\,T_0\\,B\\,F}",
      "radarSnr": "\\mathrm{SNR}_{\\mathrm{radar}} = \\frac{P_s\\,G^2\\lambda^2\\,\\sigma}{(4\\pi)^3\\,R^4\\,k\\,T_0\\,B\\,F}"
